<% content_for :title, @project.title %>

<article class="rounded bg-white border p-6">
  <% if @project.cover_image_url.present? %>
    <%= image_tag @project.cover_image_url, alt: "", class: "w-full rounded mb-4" %>
  <% end %>
  <h1 class="text-2xl font-bold mb-2"><%= @project.title %></h1>
  <p class="text-gray-600 mb-4"><%= @project.summary %></p>

  <dl class="grid grid-cols-2 gap-4 mb-6 text-sm">
    <div>
      <dt class="text-gray-500">目標金額</dt>
      <dd class="font-bold"><%= Money.format(@project.funding_goal, @project.currency) if @project.funding_goal %></dd>
    </div>
    <div>
      <dt class="text-gray-500">募資期間</dt>
      <dd><%= @project.starts_at&.strftime("%Y/%m/%d") %> – <%= @project.ends_at&.strftime("%Y/%m/%d") %></dd>
    </div>
  </dl>

  <div class="prose mb-6 text-gray-700"><%= simple_format(@project.description) %></div>

  <%= link_to "贊助專案", project_rewards_path(@project),
        class: "inline-block rounded bg-emerald-600 text-white px-5 py-2" %>
</article>
