<%# 依狀態顯示不同的「結果區塊」。這段會被 poll controller 定時重新載入 %>
<% payment = order.latest_payment %>
<% review = order.payment_needing_review %>
<% retry_link = link_to("重新結帳", project_checkout_path(order.project, reward: order.reward_id),
                        class: "inline-block rounded bg-emerald-600 text-white px-4 py-2", data: { turbo_frame: "_top" }) %>

<section class="rounded border p-6 <%= order.paid? ? 'bg-emerald-50 border-emerald-200' : 'bg-white' %>" data-status="<%= order.status %>">
  <% if review&.review_reason == "late_payment" %>
    <h1 class="text-xl font-bold mb-2">訂單<%= order.status_label %>，付款將退回</h1>
    <p>此訂單已失效，但我們收到了你的付款，將為你辦理退款。</p>

  <% elsif review&.review_reason == "amount_mismatch" %>
    <h1 class="text-xl font-bold mb-2">付款確認中</h1>
    <p>付款資訊異常，客服將與你聯繫。</p>

  <% elsif order.paid? %>
    <h1 class="text-2xl font-bold text-emerald-800 mb-2">贊助成功！</h1>
    <p>感謝你的支持，付款已完成（<%= order.paid_at&.strftime("%Y/%m/%d %H:%M") %>）。</p>

  <% elsif order.failed? %>
    <h1 class="text-xl font-bold text-red-700 mb-2">付款失敗</h1>
    <p class="mb-4">這次付款沒有成功，名額已釋放。你可以重新結帳。</p>
    <%= retry_link %>

  <% elsif order.cancelled? %>
    <h1 class="text-xl font-bold mb-2">訂單已取消</h1>
    <p class="mb-4">名額已釋放。</p>
    <%= retry_link %>

  <% elsif order.expired? %>
    <h1 class="text-xl font-bold mb-2">訂單已過期</h1>
    <p class="mb-4">超過付款期限未完成付款，訂單已取消，名額已釋放。</p>
    <%= retry_link %>

  <% elsif order.payment_method == "atm" && payment %>
    <h1 class="text-xl font-bold mb-3">請於期限內完成轉帳</h1>
    <dl class="grid grid-cols-[7rem_1fr] gap-y-1 mb-4">
      <dt class="text-gray-500">銀行代碼</dt><dd>999（Demo 假銀行）</dd>
      <dt class="text-gray-500">虛擬帳號</dt><dd class="font-mono text-lg" data-testid="virtual-account"><%= payment.virtual_account %></dd>
      <dt class="text-gray-500">應付金額</dt><dd class="font-bold"><%= order.money(order.total_amount) %></dd>
      <dt class="text-gray-500">繳費期限</dt><dd><%= payment.pay_deadline&.strftime("%Y/%m/%d %H:%M") %></dd>
    </dl>
    <p class="text-sm text-gray-600 mb-4">轉帳完成後，銀行通知約需數分鐘，請按「重新整理」查看最新狀態。</p>
    <div class="flex flex-wrap gap-3">
      <%= link_to "重新整理", order_path(order), class: "rounded border px-4 py-2", data: { turbo_frame: "_top" } %>
      <% if Rails.env.local? %>
        <%= link_to "前往假金流：模擬 ATM 轉帳", fake_gateway_atm_path(payment.provider_trade_no),
              class: "rounded bg-slate-700 text-white px-4 py-2", data: { turbo_frame: "_top" } %>
      <% end %>
      <%= button_to "取消訂單", cancel_order_path(order), method: :post,
            class: "rounded border px-4 py-2", form: { data: { turbo_frame: "_top", turbo_confirm: "確定要取消這張訂單嗎？" } } %>
    </div>

  <% else %>
    <h1 class="text-xl font-bold mb-2">付款處理中…</h1>
    <p class="text-gray-600">正在等待金流確認付款結果，頁面會自動更新。</p>
    <% if Rails.env.local? && payment %>
      <p class="mt-3 text-sm">
        <%= link_to "回到假金流付款頁", fake_gateway_pay_path(payment.provider_trade_no), class: "underline", data: { turbo_frame: "_top" } %>
      </p>
    <% end %>
  <% end %>

  <p class="mt-4 text-xs text-gray-400">訂單狀態：<%= order.status_label %></p>
</section>
