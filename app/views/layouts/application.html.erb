<!DOCTYPE html>
<html lang="zh-Hant-TW">
  <head>
    <title><%= content_for(:title) || "贊助結帳 Demo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# 可快取的讀取頁面不輸出 CSRF token（每個人的 token 不同，放了就無法共用快取） %>
    <%= csrf_meta_tags unless @public_cacheable %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-800">
    <header class="bg-white border-b">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
        <%= link_to "贊助結帳 Demo", root_path, class: "font-bold text-emerald-700" %>
        <% if Rails.env.local? %>
          <%= link_to "假金流 Demo 工具", fake_gateway_debug_path, class: "text-sm text-gray-500 hover:text-gray-800" %>
        <% end %>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-6">
      <% unless @public_cacheable %>
        <% if notice.present? %><p class="mb-4 rounded bg-emerald-50 border border-emerald-200 px-4 py-2 text-emerald-800"><%= notice %></p><% end %>
        <% if alert.present? %><p class="mb-4 rounded bg-red-50 border border-red-200 px-4 py-2 text-red-700"><%= alert %></p><% end %>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
